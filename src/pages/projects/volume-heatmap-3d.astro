---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import {
  dcarbonMapHostedUrl,
  dcarbonMapSourceUrl,
  dcarbonRepoUrl,
  siteTitle,
} from "@/data/site";

const seo = {
  title: `D-caRbon Carbon Emission 3D Map | ${siteTitle}`,
  description:
    "Interactive 3D carbon emission heatmap connected to the D-caRbon GitHub project.",
  type: "website",
};
---

<BaseLayout seo={seo}>
  <Container as="section" class="py-6">
    <div class="flex flex-col gap-6">
      <SectionHeading
        title="D-caRbon Carbon Emission 3D Map"
        description="Interactive map view hosted directly inside this website for stable access."
      />
      <p class="max-w-[52rem] text-sm leading-7 text-muted-foreground">
        The map file is now hosted locally in this site. If you prefer, you can
        still open the GitHub source file or jump to the repository.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={encodeURI(dcarbonMapHostedUrl)}
          class="inline-flex text-sm text-headings border border-border rounded-full px-4 py-2 hover:bg-muted-foreground/10 transition-colors"
        >
          Open full-screen map
        </a>
        <a
          href={encodeURI(dcarbonMapSourceUrl)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex text-sm text-headings border border-border rounded-full px-4 py-2 hover:bg-muted-foreground/10 transition-colors"
        >
          View GitHub file
        </a>
        <a
          href={encodeURI(dcarbonRepoUrl)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex text-sm text-headings border border-border rounded-full px-4 py-2 hover:bg-muted-foreground/10 transition-colors"
        >
          Open repository
        </a>
      </div>
    </div>
  </Container>

  <Container as="section" class="py-6">
    <div class="overflow-hidden rounded-[2rem] border border-border bg-card/70 shadow-sm">
      <iframe
        src={dcarbonMapHostedUrl}
        title="D-caRbon Carbon Emission 3D Map"
        loading="lazy"
        class="h-[78vh] min-h-[640px] w-full bg-background"
      />
    </div>
  </Container>
</BaseLayout>
