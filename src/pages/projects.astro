---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import ProjectItem from "@/components/ui/ProjectItem.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import {
  patents,
  projects,
  siteTitle,
  softwareCopyrights,
} from "@/data/site";

const seo = {
  title: `Projects | ${siteTitle}`,
  description:
    "Funded projects, patents, and software outputs by Sheng Wang.",
  type: "website",
};
---

<BaseLayout seo={seo}>
  <Container as="section" class="py-6">
    <div class="flex flex-col gap-6">
      <SectionHeading
        title="Projects"
        description="Funded projects and practical outputs spanning integrated energy planning, hydrogen systems, and resilience."
      />
    </div>
  </Container>

  <Container as="section" class="py-6">
    <div class="flex flex-col gap-5">
      <SectionHeading title="Funded and Collaborative Projects" />
      <ul class="flex flex-col gap-8">
        {projects.map((project) => <ProjectItem project={project} />)}
      </ul>
    </div>
  </Container>

  <Container as="section" class="py-6">
    <div class="flex flex-col gap-5">
      <SectionHeading title="Patents" />
      <ul class="flex flex-col gap-4">
        {patents.map((patent) => (
          <li class="flex flex-col gap-1">
            <span class="text-headings font-medium">{patent.title}</span>
            <span class="text-sm text-muted-foreground">
              {patent.code}
              {patent.status && <span> | {patent.status}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <Container as="section" class="py-6">
    <div class="flex flex-col gap-5">
      <SectionHeading title="Software Copyrights" />
      <ul class="flex flex-col gap-4">
        {softwareCopyrights.map((item) => (
          <li class="flex flex-col gap-1">
            {item.url ? (
              <a
                href={encodeURI(item.url)}
                target="_blank"
                rel="noopener noreferrer"
                class="text-headings font-medium hover:opacity-75 transition-opacity"
              >
                {item.title}
              </a>
            ) : (
              <span class="text-headings font-medium">{item.title}</span>
            )}
            <span class="text-sm text-muted-foreground">
              {item.code}
              {item.status && <span> | {item.status}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</BaseLayout>
